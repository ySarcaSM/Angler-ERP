# ═══════════════════════════════════════════
# Angler ERP — Firebase Configuration
# ═══════════════════════════════════════════
# Copie para .env e preencha com suas credenciais
# Obtenha em: https://console.firebase.google.com → Configurações do projeto

VITE_FIREBASE_API_KEY=SUA_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu-projeto
VITE_FIREBASE_STORAGE_BUCKET=seu-projeto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000

# ═══════════════════════════════════════════
# Admin Master — Acesso exclusivo ao painel admin
# ═══════════════════════════════════════════
# Nunca use VITE_ para segredos. Configure o superadmin no Firebase Auth,
# depois execute o script bootstrap-superadmin.mjs com credenciais de serviço.
# Variáveis de execução LOCAL/servidor, NÃO do Vite:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# SUPERADMIN_UID=uid-da-conta-administrativa

# Email de confirmação do formulário de contato (servidor/Vercel)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=Angler ERP <onboarding@resend.dev>
