rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuth() {
      return request.auth != null;
    }

    function currentUser() {
      let docPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(docPath) ? get(docPath).data : null;
    }

    function isMember(companyId) {
      let user = currentUser();
      return isAuth() && user != null && (
        user.companyId == companyId ||
        ('memberships' in user &&
          companyId in user.memberships &&
          user.memberships[companyId].active == true)
      );
    }

    function isAdmin(companyId) {
      let user = currentUser();
      return isAuth() && user != null &&
        user.role in ['owner', 'admin'] &&
        isMember(companyId);
    }

    function isOwner(companyId) {
      let user = currentUser();
      return isAuth() && user != null &&
        user.role == 'owner' &&
        isMember(companyId);
    }

    function isSuperAdmin() {
      return isAuth() &&
        request.auth.token.email == 'admin@angler-erp.local';
    }

    function isAccessRequestOwnerApproval(userId) {
      let requestDoc = get(/databases/$(database)/documents/companyAccessRequests/$(request.resource.data.accessRequestId));
      return isAuth() &&
        requestDoc.data.status == 'pending' &&
        requestDoc.data.requesterUid == userId &&
        requestDoc.data.companyId == request.resource.data.accessRequestCompanyId &&
        isOwner(requestDoc.data.companyId) &&
        request.resource.data.memberships[requestDoc.data.companyId].active == true &&
        request.resource.data.memberships[requestDoc.data.companyId].accessRequestId == request.resource.data.accessRequestId &&
        request.resource.data.memberships[requestDoc.data.companyId].role in ['admin', 'manager', 'operator', 'viewer'] &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberships', 'accessRequestId', 'accessRequestCompanyId', 'updatedAt']);
    }

    function isCompanySwitch() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['companyId', 'role']) &&
        request.resource.data.companyId is string &&
        (
          ('memberships' in resource.data &&
            request.resource.data.companyId in resource.data.memberships &&
            resource.data.memberships[request.resource.data.companyId].active == true &&
            request.resource.data.role == resource.data.memberships[request.resource.data.companyId].role) ||
          request.resource.data.companyId == resource.data.companyId
        );
    }

    match /users/{userId} {
      allow get: if isSuperAdmin() ||
        (isAuth() && request.auth.uid == userId) ||
        isOwner(resource.data.companyId);

      allow list: if isSuperAdmin() ||
        isOwner(resource.data.companyId);

      allow create: if isSuperAdmin() ||
        (isAuth() && request.auth.uid == userId && (
          request.resource.data.companyId == userId &&
          request.resource.data.role == 'owner'
        ));

      allow update: if isSuperAdmin() ||
        isOwner(resource.data.companyId) ||
        isAccessRequestOwnerApproval(userId) ||
        (isAuth() && request.auth.uid == userId && isCompanySwitch());

      allow delete: if isSuperAdmin() || isAdmin(resource.data.companyId);
    }

    match /companyAccessRequests/{requestId} {
      allow create: if isAuth() &&
        request.resource.data.requesterUid == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        exists(/databases/$(database)/documents/companies/$(request.resource.data.companyId));

      allow get: if isSuperAdmin() ||
        (isAuth() && (
          request.auth.uid == resource.data.requesterUid ||
          isOwner(resource.data.companyId)
        ));

      allow list: if isSuperAdmin() || isOwner(resource.data.companyId) ||
        (isAuth() && request.auth.uid == resource.data.requesterUid);

      allow update: if isSuperAdmin() || isOwner(resource.data.companyId);
      allow delete: if isSuperAdmin() || isOwner(resource.data.companyId);
    }

    match /companyMembers/{memberId} {
      allow read, list: if isSuperAdmin() || isOwner(resource.data.companyId);
      allow create: if isSuperAdmin() || isOwner(request.resource.data.companyId);
      allow update, delete: if isSuperAdmin() || isOwner(resource.data.companyId);
    }

    match /auditLogs/{logId} {
      allow read: if isSuperAdmin() || isAdmin(resource.data.companyId);
      allow create: if true;
    }

    match /companies/{companyId} {
      allow read: if isSuperAdmin() || isAuth();
      allow write: if isSuperAdmin() ||
        (isAuth() && request.auth.uid == companyId);
    }

    match /assistantChats/{chatId} {
      allow read, update, delete: if isSuperAdmin() ||
        (isAuth() &&
          resource.data.userId == request.auth.uid &&
          isMember(resource.data.companyId));

      allow create: if isSuperAdmin() ||
        (isAuth() &&
          request.resource.data.userId == request.auth.uid &&
          isMember(request.resource.data.companyId));

      match /messages/{messageId} {
        allow read, create, delete: if isSuperAdmin() ||
          (isAuth() &&
            get(/databases/$(database)/documents/assistantChats/$(chatId)).data.userId == request.auth.uid &&
            isMember(get(/databases/$(database)/documents/assistantChats/$(chatId)).data.companyId));
      }
    }

    match /{collection}/{docId} {
      allow read, write: if isSuperAdmin() ||
        (collection != 'assistantChats' &&
          collection != 'users' &&
          collection != 'companyAccessRequests' &&
          collection != 'companyMembers' &&
          isMember(resource.data.companyId));

      allow create: if isSuperAdmin() ||
        (collection != 'assistantChats' &&
          collection != 'users' &&
          collection != 'companyAccessRequests' &&
          collection != 'companyMembers' &&
          isMember(request.resource.data.companyId));
    }

    match /counters/{companyId} {
      allow read, write: if isSuperAdmin() || isMember(companyId);
    }
  }
}
