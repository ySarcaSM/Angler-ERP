rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuth() {
      return request.auth != null;
    }

    function currentUser() {
      let docPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(docPath) ? get(docPath).data : null;
    }

    function isMember(companyId) {
      let user = currentUser();
      return isAuth() && user != null && user.companyId == companyId;
    }

    function isAdmin(companyId) {
      let user = currentUser();
      return isAuth() && user != null && user.role in ['owner', 'admin'] && isMember(companyId);
    }

    // Superadmin — verificação por e-mail do Firebase Auth
    // O e-mail é sempre admin@angler-erp.local (não muda como o UID)
    function isSuperAdmin() {
      return isAuth() && request.auth.token.email == 'admin@angler-erp.local';
    }

    // ─── Users ───
    match /users/{userId} {
      // O usuário precisa conseguir recuperar o próprio perfil mesmo quando
      // ele foi removido e está sendo recriado no fluxo de cadastro.
      allow get: if isSuperAdmin() || (isAuth() && request.auth.uid == userId) ||
        (isAuth() && currentUser() != null && currentUser().companyId == resource.data.companyId);
      allow list: if isSuperAdmin() ||
        (isAuth() && currentUser() != null && resource.data.companyId == currentUser().companyId);
      allow create: if isAuth() && request.auth.uid == userId;
      allow update: if isSuperAdmin() || (isAuth() && (
        request.auth.uid == userId ||
        (currentUser() != null && currentUser().role in ['owner', 'admin'])
      ));
      allow delete: if isSuperAdmin() || isAdmin(resource.data.companyId);
    }

    // ─── Audit Logs ───
    match /auditLogs/{logId} {
      allow read: if isSuperAdmin() || isAdmin(resource.data.companyId);
      allow create: if true;
    }

    // ─── Companies ───
    match /companies/{companyId} {
      allow read: if isSuperAdmin() || isMember(companyId);
      allow write: if isSuperAdmin() || (isAuth() && request.auth.uid == companyId);
    }

    match /assistantChats/{chatId} {
      allow read, update, delete: if isSuperAdmin() ||
        (isAuth() && resource.data.userId == request.auth.uid && isMember(resource.data.companyId));
      allow create: if isSuperAdmin() ||
        (isAuth() && request.resource.data.userId == request.auth.uid && isMember(request.resource.data.companyId));

      match /messages/{messageId} {
        allow read, create, delete: if isSuperAdmin() ||
          (isAuth() &&
            get(/databases/$(database)/documents/assistantChats/$(chatId)).data.userId == request.auth.uid &&
            isMember(get(/databases/$(database)/documents/assistantChats/$(chatId)).data.companyId));
      }
    }

    // ─── Generic company-scoped collections ───
    match /{collection}/{docId} {
      allow read, write: if isSuperAdmin() ||
        (collection != 'assistantChats' && isMember(resource.data.companyId));
      allow create: if isSuperAdmin() ||
        (collection != 'assistantChats' && isMember(request.resource.data.companyId));
    }

    // ─── Counters ───
    match /counters/{companyId} {
      allow read, write: if isSuperAdmin() || isMember(companyId);
    }
  }
}
