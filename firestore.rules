rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuth() {
      return request.auth != null;
    }

    function currentUser() {
      let docPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(docPath) ? get(docPath).data : null;
    }

    function isMember(companyId) {
      let user = currentUser();
      return isAuth() && user != null && (
        user.companyId == companyId ||
        ('memberships' in user &&
          companyId in user.memberships &&
          user.memberships[companyId].active == true)
      );
    }

    function isAdmin(companyId) {
      let user = currentUser();
      return isAuth() && user != null &&
        user.role in ['owner', 'admin'] &&
        isMember(companyId);
    }

    function isOwner(companyId) {
      let user = currentUser();
      return isAuth() && user != null &&
        user.role == 'owner' &&
        isMember(companyId);
    }

    function isOperator(companyId) {
      let user = currentUser();
      return isAuth() && user != null &&
        user.role == 'operator' &&
        isMember(companyId);
    }

    function canWriteData(companyId) {
      return isAdmin(companyId) || isOperator(companyId);
    }

    function canDeleteData(companyId) {
      return isAdmin(companyId) || isOwner(companyId);
    }

    function isSuperAdmin() {
      return isAuth() &&
        request.auth.token.email == 'admin@angler-erp.local';
    }

    function isAccessRequestOwnerApproval(userId) {
      let requestDoc = get(/databases/$(database)/documents/companyAccessRequests/$(request.resource.data.accessRequestId));
      return isAuth() &&
        requestDoc.data.status == 'pending' &&
        requestDoc.data.requesterUid == userId &&
        requestDoc.data.companyId == request.resource.data.accessRequestCompanyId &&
        isAdmin(requestDoc.data.companyId) &&
        request.resource.data.memberships[requestDoc.data.companyId].active == true &&
        request.resource.data.memberships[requestDoc.data.companyId].accessRequestId == request.resource.data.accessRequestId &&
        request.resource.data.memberships[requestDoc.data.companyId].role in ['owner', 'admin', 'manager', 'operator', 'viewer'] &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberships', 'accessRequestId', 'accessRequestCompanyId', 'updatedAt']);
    }

    function isCompanySwitch() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['companyId', 'role']) &&
        request.resource.data.companyId is string &&
        (
          ('memberships' in resource.data &&
            request.resource.data.companyId in resource.data.memberships &&
            resource.data.memberships[request.resource.data.companyId].active == true &&
            request.resource.data.role == resource.data.memberships[request.resource.data.companyId].role) ||
          (resource.data.accessRequestCompanyId == request.resource.data.companyId &&
            resource.data.accessRequestId is string &&
            get(/databases/$(database)/documents/companyAccessRequests/$(resource.data.accessRequestId)).data.status == 'approved' &&
            get(/databases/$(database)/documents/companyAccessRequests/$(resource.data.accessRequestId)).data.requesterUid == request.auth.uid &&
            get(/databases/$(database)/documents/companyAccessRequests/$(resource.data.accessRequestId)).data.companyId == request.resource.data.companyId &&
            get(/databases/$(database)/documents/companyAccessRequests/$(resource.data.accessRequestId)).data.role == request.resource.data.role) ||
          request.resource.data.companyId == resource.data.companyId
        );
    }

    match /users/{userId} {
      allow get: if isSuperAdmin() ||
        (isAuth() && request.auth.uid == userId) ||
        isAdmin(resource.data.companyId);

      allow list: if isSuperAdmin() ||
        isAdmin(resource.data.companyId);

      allow create: if isSuperAdmin() ||
        (isAuth() && request.auth.uid == userId && (
          request.resource.data.companyId == userId &&
          request.resource.data.role == 'owner'
        ));

      allow update: if isSuperAdmin() ||
        isAdmin(resource.data.companyId) ||
        isAccessRequestOwnerApproval(userId) ||
        (isAuth() && request.auth.uid == userId && isCompanySwitch());

      allow delete: if isSuperAdmin() || isAdmin(resource.data.companyId);
    }

    match /companyAccessRequests/{requestId} {
      allow create: if isAuth() &&
        request.resource.data.requesterUid == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        exists(/databases/$(database)/documents/companies/$(request.resource.data.companyId));

      allow get: if isSuperAdmin() ||
        (isAuth() && (
          request.auth.uid == resource.data.requesterUid ||
          isAdmin(resource.data.companyId)
        ));

      allow list: if isSuperAdmin() || isAdmin(resource.data.companyId) ||
        (isAuth() && request.auth.uid == resource.data.requesterUid);

      allow update: if isSuperAdmin() || isAdmin(resource.data.companyId);
      allow delete: if isSuperAdmin() || isOwner(resource.data.companyId);
    }

    match /companyMembers/{memberId} {
      allow read, list: if isSuperAdmin() || isAdmin(resource.data.companyId);
      allow create: if isSuperAdmin() || isAdmin(request.resource.data.companyId);
      allow update, delete: if isSuperAdmin() || isAdmin(resource.data.companyId);
    }

    match /auditLogs/{logId} {
      allow read: if isSuperAdmin() || isAdmin(resource.data.companyId);
      allow create: if true;
    }

    match /deletionRequests/{requestId} {
      allow create: if isSuperAdmin() ||
        (isOperator(request.resource.data.companyId) &&
          request.resource.data.requesterUid == request.auth.uid &&
          request.resource.data.status == 'pending');

      allow get, list: if isSuperAdmin() || isAdmin(resource.data.companyId) || isOwner(resource.data.companyId);

      allow update: if isSuperAdmin() || isAdmin(resource.data.companyId) || isOwner(resource.data.companyId);
      allow delete: if isSuperAdmin() || isOwner(resource.data.companyId);
    }

    match /companies/{companyId} {
      allow read: if isSuperAdmin() || isAuth();
      allow write: if isSuperAdmin() ||
        (isAuth() && request.auth.uid == companyId);
    }

    match /assistantChats/{chatId} {
      allow read: if isSuperAdmin() || (isAuth() && isMember(resource.data.companyId));
      allow update: if isSuperAdmin() || canWriteData(resource.data.companyId);
      allow delete: if isSuperAdmin() || canDeleteData(resource.data.companyId);

      allow create: if isSuperAdmin() ||
        (isAuth() &&
          request.resource.data.userId == request.auth.uid &&
          canWriteData(request.resource.data.companyId));

      match /messages/{messageId} {
        allow read: if isSuperAdmin() ||
          (isAuth() && isMember(get(/databases/$(database)/documents/assistantChats/$(chatId)).data.companyId));
        allow create, update: if isSuperAdmin() ||
          (isAuth() && canWriteData(get(/databases/$(database)/documents/assistantChats/$(chatId)).data.companyId));
        allow delete: if isSuperAdmin() ||
          (isAuth() && canDeleteData(get(/databases/$(database)/documents/assistantChats/$(chatId)).data.companyId));
      }
    }

    match /{collection}/{docId} {
      allow read: if isSuperAdmin() ||
        (collection != 'assistantChats' &&
          collection != 'users' &&
          collection != 'companyAccessRequests' &&
          collection != 'companyMembers' &&
          collection != 'deletionRequests' &&
          isMember(resource.data.companyId));

      allow create: if isSuperAdmin() ||
        (collection != 'assistantChats' &&
          collection != 'users' &&
          collection != 'companyAccessRequests' &&
          collection != 'companyMembers' &&
          collection != 'deletionRequests' &&
          canWriteData(request.resource.data.companyId));

      allow update: if isSuperAdmin() ||
        (collection != 'assistantChats' &&
          collection != 'users' &&
          collection != 'companyAccessRequests' &&
          collection != 'companyMembers' &&
          collection != 'deletionRequests' &&
          canWriteData(resource.data.companyId));

      allow delete: if isSuperAdmin() ||
        (collection != 'assistantChats' &&
          collection != 'users' &&
          collection != 'companyAccessRequests' &&
          collection != 'companyMembers' &&
          collection != 'deletionRequests' &&
          canDeleteData(resource.data.companyId));
    }

    match /counters/{companyId} {
      allow read: if isSuperAdmin() || isMember(companyId);
      allow write: if isSuperAdmin() || canWriteData(companyId);
    }
  }
}
