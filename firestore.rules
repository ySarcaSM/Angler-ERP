rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuth() {
      return request.auth != null;
    }

    function currentUser() {
      let docPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(docPath) ? get(docPath).data : null;
    }

    function isMember(companyId) {
      let user = currentUser();
      return isAuth() && user != null && (\n        user.companyId == companyId ||\n        ('memberships' in user && companyId in user.memberships && user.memberships[companyId].active == true)\n      );
    }

    function isAdmin(companyId) {
      let user = currentUser();
      return isAuth() && user != null && user.role in ['owner', 'admin'] && isMember(companyId);
    }

    function isOwner(companyId) {
      let user = currentUser();
      return isAuth() && user != null && user.role == 'owner' && isMember(companyId);
    }

    // Superadmin — verificação por e-mail do Firebase Auth
    // O e-mail é sempre admin@angler-erp.local (não muda como o UID)
    function isSuperAdmin() {
      return isAuth() && request.auth.token.email == 'admin@angler-erp.local';
    }

    function hasValidInvitation(userId) {
      return request.resource.data.invitationId is string &&
        exists(/databases/$(database)/documents/companyInvitations/$(request.resource.data.invitationId)) &&
        get(/databases/$(database)/documents/companyInvitations/$(request.resource.data.invitationId)).data.status == 'active' &&
        get(/databases/$(database)/documents/companyInvitations/$(request.resource.data.invitationId)).data.companyId == request.resource.data.companyId &&
        get(/databases/$(database)/documents/companyInvitations/$(request.resource.data.invitationId)).data.email == request.auth.token.email &&
        get(/databases/$(database)/documents/companyInvitations/$(request.resource.data.invitationId)).data.role == request.resource.data.role &&
        request.resource.data.role in ['admin', 'manager', 'operator', 'viewer'];
    }

    // ─── Users ───
    match /users/{userId} {
      // O usuário precisa conseguir recuperar o próprio perfil mesmo quando
      // ele foi removido e está sendo recriado no fluxo de cadastro.
      allow get: if isSuperAdmin() || (isAuth() && request.auth.uid == userId) || isOwner(resource.data.companyId);
      allow list: if isSuperAdmin() || isOwner(resource.data.companyId);
      allow create: if isSuperAdmin() || (isAuth() && request.auth.uid == userId && (
        (request.resource.data.companyId == userId && request.resource.data.role == 'owner') ||
        hasValidInvitation(userId)
      ));
      allow update: if isSuperAdmin() || (isAuth() && (
        request.auth.uid == userId || isOwner(resource.data.companyId)
      ));
      allow delete: if isSuperAdmin() || isAdmin(resource.data.companyId);
    }

    // ─── Audit Logs ───
    match /auditLogs/{logId} {
      allow read: if isSuperAdmin() || isAdmin(resource.data.companyId);
      allow create: if true;
    }

    // ─── Companies ───
    match /companies/{companyId} {
      allow read: if isSuperAdmin() || isMember(companyId);
      allow write: if isSuperAdmin() || (isAuth() && request.auth.uid == companyId);
    }

    match /assistantChats/{chatId} {
      allow read, update, delete: if isSuperAdmin() ||
        (isAuth() && resource.data.userId == request.auth.uid && isMember(resource.data.companyId));
      allow create: if isSuperAdmin() ||
        (isAuth() && request.resource.data.userId == request.auth.uid && isMember(request.resource.data.companyId));

      match /messages/{messageId} {
        allow read, create, delete: if isSuperAdmin() ||
          (isAuth() &&
            get(/databases/$(database)/documents/assistantChats/$(chatId)).data.userId == request.auth.uid &&
            isMember(get(/databases/$(database)/documents/assistantChats/$(chatId)).data.companyId));
      }
    }

    match /companyInvitations/{inviteId} {
      allow get: if true;
      allow list: if isSuperAdmin() || isOwner(resource.data.companyId);
      allow create: if isSuperAdmin() || (isOwner(request.resource.data.companyId) &&
        request.resource.data.status == 'active' &&
        request.resource.data.role in ['admin', 'manager', 'operator', 'viewer']);
      allow update: if isSuperAdmin() || isOwner(resource.data.companyId) || (
        isAuth() && resource.data.status == 'active' &&
        request.resource.data.status == 'accepted' &&
        request.resource.data.acceptedBy == request.auth.uid &&
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == resource.data.companyId &&
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.invitationId == inviteId &&
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.email == resource.data.email &&
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == resource.data.role
      );
      allow delete: if isSuperAdmin() || isOwner(resource.data.companyId);
    }

    // ─── Generic company-scoped collections ───
    match /{collection}/{docId} {
      allow read, write: if isSuperAdmin() ||
        (collection != 'assistantChats' && collection != 'companyInvitations' && collection != 'users' && isMember(resource.data.companyId));
      allow create: if isSuperAdmin() ||
        (collection != 'assistantChats' && collection != 'companyInvitations' && collection != 'users' && isMember(request.resource.data.companyId));
    }

    // ─── Counters ───
    match /counters/{companyId} {
      allow read, write: if isSuperAdmin() || isMember(companyId);
    }
  }
}
