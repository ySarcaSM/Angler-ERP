rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuth() {
      return request.auth != null;
    }

    function currentUser() {
      let docPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(docPath) ? get(docPath).data : null;
    }

    function isMember(companyId) {
      let user = currentUser();
      return isAuth() && user != null && (
        user.companyId == companyId ||
        ('memberships' in user &&
          companyId in user.memberships &&
          user.memberships[companyId].active == true)
      );
    }

    function isAdmin(companyId) {
      let user = currentUser();
      return isAuth() && user != null &&
        user.role in ['owner', 'admin'] &&
        isMember(companyId);
    }

    function isOwner(companyId) {
      let user = currentUser();
      return isAuth() && user != null &&
        user.role == 'owner' &&
        isMember(companyId);
    }

    function isSuperAdmin() {
      return isAuth() &&
        request.auth.token.email == 'admin@angler-erp.local';
    }

    function hasValidInvitation() {
      return request.resource.data.invitationId is string &&
        exists(/databases/$(database)/documents/companyInvitations/$(request.resource.data.invitationId)) &&
        get(/databases/$(database)/documents/companyInvitations/$(request.resource.data.invitationId)).data.status == 'active' &&
        get(/databases/$(database)/documents/companyInvitations/$(request.resource.data.invitationId)).data.companyId == request.resource.data.companyId &&
        get(/databases/$(database)/documents/companyInvitations/$(request.resource.data.invitationId)).data.email == request.auth.token.email &&
        get(/databases/$(database)/documents/companyInvitations/$(request.resource.data.invitationId)).data.role == request.resource.data.role &&
        request.resource.data.role in ['admin', 'manager', 'operator', 'viewer'];
    }


    function isAccessRequestOwnerApproval(userId) {
      let target = get(/databases/$(database)/documents/users/$(userId));
      let requestDoc = getAfter(/databases/$(database)/documents/companyAccessRequests/$(request.resource.data.accessRequestId));
      return isAuth() &&
        requestDoc.data.status == 'approved' &&
        requestDoc.data.requesterUid == userId &&
        requestDoc.data.companyId == request.resource.data.accessRequestCompanyId &&
        requestDoc.data.role == request.resource.data.memberships[request.resource.data.accessRequestCompanyId].role &&
        isOwner(requestDoc.data.companyId) &&
        request.resource.data.memberships[requestDoc.data.companyId].active == true &&
        request.resource.data.memberships[requestDoc.data.companyId].accessRequestId == request.resource.data.accessRequestId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberships', 'accessRequestId', 'accessRequestCompanyId', 'updatedAt']);
    }

    function isCompanySwitch() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['companyId', 'role']) &&
        request.resource.data.companyId is string &&
        (
          ('memberships' in resource.data &&
            request.resource.data.companyId in resource.data.memberships &&
            resource.data.memberships[request.resource.data.companyId].active == true &&
            request.resource.data.role == resource.data.memberships[request.resource.data.companyId].role) ||
          request.resource.data.companyId == resource.data.companyId
        );
    }

    function isJoiningCompany() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'name', 'lastName', 'companyId', 'role', 'invitationId', 'memberships', 'active'
      ]) &&
        hasValidInvitation() &&
        request.resource.data.companyId != resource.data.companyId &&
        (!('memberships' in resource.data) ||
          !(request.resource.data.companyId in resource.data.memberships)) &&
        request.resource.data.memberships[request.resource.data.companyId].active == true &&
        request.resource.data.memberships[request.resource.data.companyId].role == request.resource.data.role &&
        request.resource.data.memberships.diff(resource.data.memberships).affectedKeys().hasOnly([
          request.resource.data.companyId
        ]);
    }

    // ─── Users ───
    match /users/{userId} {
      allow get: if isSuperAdmin() ||
        (isAuth() && request.auth.uid == userId) ||
        isOwner(resource.data.companyId);

      allow list: if isSuperAdmin() ||
        isOwner(resource.data.companyId);

      allow create: if isSuperAdmin() ||
        (isAuth() && request.auth.uid == userId && (
          (request.resource.data.companyId == userId &&
            request.resource.data.role == 'owner') ||
          hasValidInvitation()
        ));

      // Self-update is intentionally restricted so a user cannot promote
      // themselves or manufacture memberships. Company owners/admins keep
      // their existing management permissions.
      allow update: if isSuperAdmin() ||
        isOwner(resource.data.companyId) ||
        (isAuth() && request.auth.uid == userId &&
          (isCompanySwitch() || isJoiningCompany() || isAccessRequestOwnerApproval(userId)));

      allow delete: if isSuperAdmin() ||
        isAdmin(resource.data.companyId);
    }

    // ─── Company access requests ───
    match /companyAccessRequests/{requestId} {
      allow create: if isAuth() &&
        request.resource.data.requesterUid == request.auth.uid &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.status == 'pending' &&
        exists(/databases/$(database)/documents/companies/$(request.resource.data.companyId));

      allow get: if isSuperAdmin() ||
        (isAuth() && (
          request.auth.uid == resource.data.requesterUid ||
          isOwner(resource.data.companyId)
        ));

      allow list: if isSuperAdmin() || isOwner(resource.data.companyId);

      allow update: if isSuperAdmin() ||
        isOwner(resource.data.companyId);

      allow delete: if isSuperAdmin() || isOwner(resource.data.companyId);
    }

    // ─── Audit Logs ───
    match /auditLogs/{logId} {
      allow read: if isSuperAdmin() ||
        isAdmin(resource.data.companyId);
      allow create: if true;
    }

    // ─── Companies ───
    match /companies/{companyId} {
      allow read: if isSuperAdmin() || isMember(companyId);
      allow write: if isSuperAdmin() ||
        (isAuth() && request.auth.uid == companyId);
    }

    match /assistantChats/{chatId} {
      allow read, update, delete: if isSuperAdmin() ||
        (isAuth() &&
          resource.data.userId == request.auth.uid &&
          isMember(resource.data.companyId));

      allow create: if isSuperAdmin() ||
        (isAuth() &&
          request.resource.data.userId == request.auth.uid &&
          isMember(request.resource.data.companyId));

      match /messages/{messageId} {
        allow read, create, delete: if isSuperAdmin() ||
          (isAuth() &&
            get(/databases/$(database)/documents/assistantChats/$(chatId)).data.userId == request.auth.uid &&
            isMember(get(/databases/$(database)/documents/assistantChats/$(chatId)).data.companyId));
      }
    }

    // ─── Company invitations ───
    match /companyInvitations/{inviteId} {
      allow get: if true;

      allow list: if isSuperAdmin() ||
        isOwner(resource.data.companyId);

      allow create: if isSuperAdmin() ||
        (isOwner(request.resource.data.companyId) &&
          request.resource.data.status == 'active' &&
          request.resource.data.role in ['admin', 'manager', 'operator', 'viewer']);

      allow update: if isSuperAdmin() ||
        isOwner(resource.data.companyId) ||
        (isAuth() &&
          resource.data.status == 'active' &&
          request.resource.data.status == 'accepted' &&
          request.resource.data.acceptedBy == request.auth.uid &&
          getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == resource.data.companyId &&
          getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.invitationId == inviteId &&
          getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.email == resource.data.email &&
          getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == resource.data.role
        );

      allow delete: if isSuperAdmin() ||
        isOwner(resource.data.companyId);
    }

    // ─── Generic company-scoped collections ───
    match /{collection}/{docId} {
      allow read, write: if isSuperAdmin() ||
        (collection != 'assistantChats' &&
          collection != 'companyInvitations' &&
          collection != 'users' &&
          isMember(resource.data.companyId));

      allow create: if isSuperAdmin() ||
        (collection != 'assistantChats' &&
          collection != 'companyInvitations' &&
          collection != 'users' &&
          isMember(request.resource.data.companyId));
    }

    // ─── Counters ───
    match /counters/{companyId} {
      allow read, write: if isSuperAdmin() ||
        isMember(companyId);
    }
  }
}
